# Write the git commit of the source tree and whether its native sources differ
# from it (staged, unstaged or untracked files) into OUTPUT, a source file of _core.
# The build runs this script every time, so that a rebuild after a commit or an
# edit records the current state; file(CONFIGURE) rewrites OUTPUT only when its
# contents change, so an unchanged state compiles nothing.
#
# Usage: cmake -DSRC=<source dir> -DGIT=<git executable> -DOUTPUT=<file> -P git_info.cmake

set(POLYMERFTS_GIT_COMMIT "unknown")
set(POLYMERFTS_SOURCE_MODIFIED "unknown")
# git status would otherwise refresh the index under .git/index.lock, and a git
# command of the user at the same moment would fail on that lock
set(ENV{GIT_OPTIONAL_LOCKS} 0)
if(GIT AND EXISTS "${SRC}/.git")
    execute_process(COMMAND "${GIT}" rev-parse HEAD
        WORKING_DIRECTORY "${SRC}" OUTPUT_VARIABLE _commit RESULT_VARIABLE _commit_result
        OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
    if(_commit_result EQUAL 0)
        set(POLYMERFTS_GIT_COMMIT "${_commit}")
    endif()
    execute_process(COMMAND "${GIT}" status --porcelain --untracked-files=normal -- CMakeLists.txt cmake src
        WORKING_DIRECTORY "${SRC}" OUTPUT_VARIABLE _changes RESULT_VARIABLE _status_result ERROR_QUIET)
    if(_status_result EQUAL 0)
        if(_changes STREQUAL "")
            set(POLYMERFTS_SOURCE_MODIFIED "false")
        else()
            set(POLYMERFTS_SOURCE_MODIFIED "true")
        endif()
    endif()
endif()

file(CONFIGURE OUTPUT "${OUTPUT}" CONTENT [[// Generated by cmake/git_info.cmake at every build
const char* polymerfts_git_commit() { return R"meta(@POLYMERFTS_GIT_COMMIT@)meta"; }
const char* polymerfts_source_modified() { return R"meta(@POLYMERFTS_SOURCE_MODIFIED@)meta"; }
]] @ONLY)
