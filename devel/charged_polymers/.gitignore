# Local LaTeX build products; keep editable sources and report PDFs.
*.aux
*.log
*.synctex.gz

# Rebuildable products from the two-report builder.
reports/build/
archive/build/
__pycache__/

# Locally stored reference papers.
/refs/

# Local seminar decks and rendered presentation assets.
/presentations/

# Preserve the unique report/archive assets, including archived TeX dependencies.
!reports/figures/historical/*.png
!archive/figures/*.png
!archive/prl_comparison_figs/*.png
