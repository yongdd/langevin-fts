examples/lfts*/Test*
examples/scft*/*.m
examples/scft*/Test*
examples/scft*/plot*.*
examples/scft/*.json
examples/scft/phases/*.json
examples/temp*
examples/test*
devel/test*
devel/*.m
devel/cl-fts/
devel/wtmd_*/
